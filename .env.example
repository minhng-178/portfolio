# Local development config for the API (`npm run dev:api` loads ../.env).
# In production set these as environment variables on the hosting platform.
# .env itself is gitignored — never commit real values.

# --- Chat (LLM) -------------------------------------------------------------
# Any OpenAI-compatible Chat Completions endpoint. Chat stays disabled (widget
# hidden) until LLM_BASE_URL and LLM_MODEL are both set.
#   Local Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2:3b
#   Hosted:        the provider's OpenAI-compatible base URL + API key
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- CORS ---------------------------------------------------------------------
# Origins allowed to call the API, comma-separated (scheme + host, no trailing
# slash). Production: your GitHub Pages / custom domain origin.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Client IP for rate limiting ------------------------------------------------
# Header your platform's edge sets with the real client IP, e.g.
# cf-connecting-ip (Cloudflare) or x-real-ip (Vercel). Leave empty locally.
CLIENT_IP_HEADER=

# --- Contact form email -----------------------------------------------------------
# Gmail: enable 2-Step Verification, create an App Password, paste it below.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
CONTACT_RECEIVER_EMAIL=your-email@gmail.com
# 1 = log messages instead of sending (local testing without SMTP).
MAIL_DRY_RUN=
