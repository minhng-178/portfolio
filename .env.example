# Copy this file to .env on the VPS and fill in real values.
# .env itself is gitignored - never commit real values.

# The production origin(s) allowed to call the backend, comma-separated.
# Must match your GitHub Pages URL exactly (scheme + host, no trailing slash).
ALLOWED_ORIGINS=https://exmaple.com
# Model to run in Ollama. llama3.1:8b needs an 8GB+ RAM VPS; use llama3.2:3b
# on smaller/cheaper VPS tiers (4GB RAM).
OLLAMA_MODEL=exmaple-model

# Free HTTPS hostname pointing at this VPS's public IP, e.g. 203.0.113.10.sslip.io
# (replace with your VPS's real IP - no DNS setup needed, sslip.io resolves
# automatically). Caddy uses this to request a Let's Encrypt certificate.
BACKEND_HOSTNAME=0.0.0.0/0

# SMTP settings for contact form email delivery (e.g. Gmail App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
CONTACT_RECEIVER_EMAIL=your-email@gmail.com

